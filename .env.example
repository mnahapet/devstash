# Neon PostgreSQL — pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Neon PostgreSQL — direct connection (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-xxx-direct.us-east-2.aws.neon.tech/dbname?sslmode=require"
